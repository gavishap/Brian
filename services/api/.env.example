# Copy to .env for local development. Values below match `supabase start` defaults.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres. Local Supabase: port 54322. Hosted Supabase: use the connection string from
# Project Settings -> Database (the transaction pooler on port 6543 works; prepared statements
# are disabled for it).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth. Tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
# Only for projects still on the legacy shared HS256 secret (`supabase status` shows it locally):
# SUPABASE_JWT_SECRET=
# Lets account deletion also remove the auth user (Project Settings -> API -> service_role):
# SUPABASE_SERVICE_ROLE_KEY=

# Claude. Without a key the app still works: nudges use templates and chat reports it is offline.
ANTHROPIC_API_KEY=
LLM_ENABLED=true
COACH_MODEL=claude-opus-5-5
COACH_EFFORT=medium
COPY_MODEL=claude-opus-5-5
COPY_EFFORT=low
REFLECTION_MODEL=claude-opus-5-5
REFLECTION_EFFORT=high

# Expo push. Optional access token if "enhanced push security" is on in your Expo account.
# EXPO_ACCESS_TOKEN=
# Log pushes instead of sending them (handy with no device):
PUSH_DRY_RUN=false
# iOS Simulator on your Mac: nudges for the Simulator are delivered with `xcrun simctl push` to this
# bundle id (keep in sync with ios.bundleIdentifier in apps/mobile/app.config.ts).
PUSH_SIMULATOR_BUNDLE_ID=com.example.brian

# Browser preview of the app (`npx expo start --web`) needs CORS:
# CORS_ORIGINS=["http://localhost:8081"]

# Shared secret for POST /internal/tick (only needed if an external cron drives the jobs).
# INTERNAL_API_KEY=
