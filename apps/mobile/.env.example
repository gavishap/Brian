# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (never put secrets here).

# Brian API base URL. On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase project URL and anon (publishable) key. `npx supabase status` prints the local values.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS project id (from `npx eas-cli@latest init`); required for Expo push tokens.
EAS_PROJECT_ID=
